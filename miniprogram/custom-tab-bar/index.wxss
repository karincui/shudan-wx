.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  pointer-events: none;
  padding: 0 28rpx 16rpx;
  box-sizing: border-box;
}

.tabbar {
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 112rpx;
  padding: 0 8rpx;
  background: #ffffff;
  border-radius: 999rpx;
  border: 1rpx solid rgba(42, 36, 28, 0.06);
  box-shadow: 0 10rpx 36rpx rgba(42, 36, 28, 0.12);
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-ico {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  font-size: 20rpx;
  line-height: 1.2;
  color: #8a8677;
}

.tab-item.on .tab-text {
  color: #1f6f5c;
  font-weight: 600;
}

