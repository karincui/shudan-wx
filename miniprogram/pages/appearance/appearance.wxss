.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 80rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  color: var(--ink);
}

.title.gap {
  margin-top: 28rpx;
}

.mode-row {
  display: flex;
  gap: 12rpx;
}

.mode-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--muted);
}

.mode-item.on {
  border-color: var(--teal);
  color: var(--teal);
  background: rgba(47, 111, 106, 0.08);
  font-weight: 600;
}

.mode-preview {
  width: 72rpx;
  height: 48rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
}

.mode-preview.day {
  background: linear-gradient(135deg, #f6f4ef, #ffffff);

}

.mode-preview.night {
  background: linear-gradient(135deg, #121418, #1e242c);
}

.mode-preview.custom {
  background: #f6f4ef;

}

.preview-card {
  border: 1rpx solid var(--line);
  position: relative;
  overflow: hidden;
  min-height: 220rpx;
}

.preview-inner {
  position: relative;
  z-index: 1;
}

.opacity-block {
  margin-top: 20rpx;
  margin-bottom: 8rpx;
}

.opacity-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.opacity-title {
  margin-bottom: 8rpx;
}

.opacity-val {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--teal);
  flex-shrink: 0;
}

.opacity-slider {
  margin: 4rpx 0 0;
}

.preview-label {
  font-size: 22rpx;
  margin-bottom: 12rpx;
  opacity: 0.7;
}

.hint {
  font-size: 22rpx;
  line-height: 1.5;
  margin-bottom: 14rpx;
}

.bg-actions {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.bg-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  background: var(--teal);
  color: #fff;
  font-size: 26rpx;
}

.bg-btn.ghost {
  background: transparent;
  color: var(--teal);
  border: 1rpx solid var(--line);
}

.bg-thumb {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  display: block;
  background: var(--bg);
}

.preview-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.preview-body {
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.preview-chip {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  border: 1rpx solid rgba(127, 127, 127, 0.25);
}

.swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
  box-shadow: inset 0 0 0 1rpx rgba(127, 127, 127, 0.35);
}

.swatch.on {
  border-color: var(--teal);
  box-shadow: 0 0 0 4rpx rgba(47, 111, 106, 0.25);
}

.hex-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.hex-label {
  width: 64rpx;
  font-size: 24rpx;
}

.hex-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: var(--bg);
  border: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 26rpx;
}

.actions {
  margin-top: 12rpx;
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}

.act-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.act-btn.ghost {
  background: #ffffff;
  border: 1px solid #e7e3d9;
  color: #5a5046;
}

.act-btn.primary {
  background: linear-gradient(135deg, #1f6f5c 0%, #3fb6a0 100%);
  color: #ffffff;
  border: none;
}

.act-btn.disabled {
  opacity: 0.55;
  pointer-events: none;
}
