.page.paper-mint {
  --paper: #f6f4ef;
  --card: #ffffff;
  --line: #e7e3d9;
  --ink: #24261f;
  --muted: #8a8677;
  --soft: #b3aea0;
  --teal: #1f6f5c;
  --mint: #3fb6a0;
  --mint-soft: #e7f3ef;
  min-height: 100vh;
  background: var(--paper);
  color: var(--ink);
  box-sizing: border-box;
  padding: 0 0 calc(48rpx + env(safe-area-inset-bottom));
}

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(246, 244, 239, 0.94);
  backdrop-filter: blur(12px);
}

.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.nav-back {
  position: absolute;
  left: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  line-height: 1;
  color: var(--teal);
  font-weight: 300;
}

.nav-back-hover {
  opacity: 0.65;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--teal);
}

.nav-spacer {
  width: 100%;
}

.content {
  padding: 16rpx 28rpx 48rpx;
  box-sizing: border-box;
}


.card {
  background: var(--card);
  border: 1rpx solid rgba(42, 36, 28, 0.08);
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.add-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.add-input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 28rpx 0 24rpx;
  height: 72rpx;
  background: #ffffff;
  border: 1px solid #e7e3d9;
  border-radius: 16px;
  box-sizing: border-box;
}

.add-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0;
  background: transparent;
  border: none;
  font-size: 26rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.add-btn {
  flex-shrink: 0;
  min-width: 120rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 999rpx;
  background: #1f6f5c;
  color: #fff;
  font-size: 26rpx;
}

.add-plus {
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1;
}

.add-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.search-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 0 28rpx;
  padding: 0 28rpx 0 24rpx;
  height: 72rpx;
  background: #ffffff;
  border: 1px solid #e7e3d9;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.search-ico {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  display: block;
}

.search {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0;
  background: transparent;
  border: none;
  font-size: 26rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.search-ph {
  color: #b0a79c;
  font-size: 26rpx;
}

.search-clear {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(42, 36, 28, 0.08);
  color: #8a7f72;
  font-size: 28rpx;
}


.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
}

.section-count {
  font-size: 22rpx;
}

.empty {
  padding: 48rpx 12rpx;
  text-align: center;
  font-size: 24rpx;
}

.sort-hint {
  margin: -4rpx 0 16rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.page.is-dragging {
  overflow: hidden;
}

.tag-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tag-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 16rpx 12rpx 10rpx;
  background: var(--card);
  border: 1rpx solid rgba(42, 36, 28, 0.08);
  border-radius: 16rpx;
  box-sizing: border-box;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.tag-row.is-ghost {
  opacity: 0.28;
  border-style: dashed;
  background: rgba(31, 111, 92, 0.04);
}

.drag-handle {
  flex-shrink: 0;
  width: 44rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.drag-handle-ico {
  width: 28rpx;
  height: 28rpx;
  display: block;
  opacity: 0.7;
}

.tag-chip {
  min-width: 0;
  flex: 1;
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.chip-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-acts {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 36rpx;
  justify-content: flex-end;
}

.del-x {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e1e3e5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.del-x-hover {
  background: #d5d8db;
  opacity: 1;
}

.del-x-ico {
  width: 18rpx;
  height: 18rpx;
  display: block;
}

.drag-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2000;
  background: transparent;
}

.drag-float {
  position: fixed;
  z-index: 2001;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx 12rpx 10rpx;
  background: var(--card);
  border: 1rpx solid rgba(31, 111, 92, 0.28);
  border-radius: 16rpx;
  box-shadow: 0 16rpx 40rpx rgba(36, 38, 31, 0.16);
  box-sizing: border-box;
  pointer-events: none;
}

.boot-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1800;
  background: rgba(246, 244, 239, 0.88);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.boot-card {
  width: 100%;
  max-width: 420rpx;
  padding: 56rpx 40rpx 48rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1px solid #e7e3d9;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  box-sizing: border-box;
  animation: boot-pop 0.35s cubic-bezier(0.34, 1.45, 0.64, 1) both;
}

.boot-orbit {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.boot-ring {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  border: 4rpx solid #e7f3ef;
  border-top-color: #1f6f5c;
  border-right-color: #3fb6a0;
  animation: boot-spin 0.9s linear infinite;
  box-sizing: border-box;
}

.boot-book {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1f6f5c 0%, #3fb6a0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: boot-pulse 1.4s ease-in-out infinite;
}

.boot-book-char {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.boot-dot {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3fb6a0;
}

.boot-dot.d1 {
  top: 8rpx;
  left: 50%;
  margin-left: -6rpx;
  animation: boot-dot 1.2s ease-in-out infinite;
}

.boot-dot.d2 {
  right: 10rpx;
  bottom: 28rpx;
  background: #1f6f5c;
  animation: boot-dot 1.2s ease-in-out 0.2s infinite;
}

.boot-dot.d3 {
  left: 10rpx;
  bottom: 28rpx;
  background: #c9852a;
  animation: boot-dot 1.2s ease-in-out 0.4s infinite;
}

.boot-text {
  font-size: 26rpx;
  color: #5a5046;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.boot-bars {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 10rpx;
  height: 28rpx;
}

.boot-bar {
  width: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #3fb6a0 0%, #1f6f5c 100%);
  animation: boot-bar 0.9s ease-in-out infinite;
}

.boot-bar.b1 { height: 12rpx; animation-delay: 0s; }
.boot-bar.b2 { height: 22rpx; animation-delay: 0.15s; }
.boot-bar.b3 { height: 16rpx; animation-delay: 0.3s; }

@keyframes boot-pop {
  from { opacity: 0; transform: scale(0.92) translateY(12rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
@keyframes boot-spin { to { transform: rotate(360deg); } }
@keyframes boot-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(0.92); }
}
@keyframes boot-dot {
  0%, 100% { opacity: 0.35; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1.15); }
}
@keyframes boot-bar {
  0%, 100% { transform: scaleY(0.55); opacity: 0.45; }
  50% { transform: scaleY(1); opacity: 1; }
}
