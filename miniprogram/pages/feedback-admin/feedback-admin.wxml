<view class="page paper-mint" style="{{pageTheme}}">
  <boot-loading wx:if="{{loading}}" text="{{loadingText}}" char="管" />

  <view class="content">
    <view class="tabs">
      <view
        class="tab {{status === 'open' ? 'on' : ''}}"
        data-status="open"
        bindtap="onStatusTab"
      >待处理</view>
      <view
        class="tab {{status === 'done' ? 'on' : ''}}"
        data-status="done"
        bindtap="onStatusTab"
      >已处理</view>
      <view
        class="tab {{status === 'all' ? 'on' : ''}}"
        data-status="all"
        bindtap="onStatusTab"
      >全部</view>
    </view>

    <view wx:if="{{denied}}" class="empty">
      <text class="empty-title">无管理员权限</text>
      <text class="empty-desc">请先复制 OpenID，写入 app_config / admins 后再试</text>
    </view>

    <view wx:elif="{{!loading && !list.length}}" class="empty">
      <text class="empty-title">暂无反馈</text>
      <text class="empty-desc">用户提交后会出现在这里</text>
    </view>

    <view wx:else class="list">
      <view class="card" wx:for="{{list}}" wx:key="id">
        <view class="card-top">
          <text class="card-time">{{item.createdAtText}}</text>
          <text class="card-status {{item.status}}">{{item.status === 'done' ? '已处理' : '待处理'}}</text>
        </view>
        <text class="card-content">{{item.content}}</text>
        <text wx:if="{{item.contact}}" class="card-contact">联系：{{item.contact}}</text>
        <view class="card-acts">
          <view
            wx:if="{{item.status !== 'done'}}"
            class="act primary"
            data-id="{{item.id}}"
            catchtap="markDone"
          >标为已处理</view>
          <view
            wx:else
            class="act ghost"
            data-id="{{item.id}}"
            catchtap="markOpen"
          >重新打开</view>
        </view>
      </view>
    </view>
  </view>
  <mint-toast id="mintToast" />
</view>
