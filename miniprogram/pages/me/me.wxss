.page.paper-mint {
  --paper: #f6f4ef;
  --card: #ffffff;
  --line: #e7e3d9;
  --ink: #24261f;
  --muted: #8a8677;
  --soft: #b3aea0;
  --teal: #1f6f5c;
  --mint: #3fb6a0;
  --mint-soft: #e7f3ef;
  --amber-soft: #f6efe4;
  --night-soft: #eef2f7;
  min-height: 100vh;
  background: var(--paper);
  color: var(--ink);
  box-sizing: border-box;
  padding: 0;
}

.page.paper-mint.is-dark {
  --paper: #12141a;
  --card: #1c1f27;
  --line: #2c303b;
  --ink: #edeff5;
  --muted: #9aa1b2;
  --soft: #9aa1b2;
  --teal: #5fd3b4;
  --mint: #5fd3b4;
  --mint-soft: rgba(95, 211, 180, 0.14);
  --amber-soft: rgba(201, 133, 42, 0.16);
  --night-soft: rgba(95, 211, 180, 0.14);
}

.page-with-tab {
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(246, 244, 239, 0.94);
  backdrop-filter: blur(12px);
}

.page.is-dark .nav {
  background: rgba(18, 20, 26, 0.94);
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 28rpx;
  box-sizing: border-box;
}

.nav-title {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--teal);
  line-height: 1.2;
}

.nav-spacer {
  width: 100%;
}

.content {
  position: relative;
  padding: 8rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.wash {
  position: absolute;
  left: -40rpx;
  right: -40rpx;
  top: -80rpx;
  height: 360rpx;
  background:
    radial-gradient(ellipse 70% 80% at 18% 30%, rgba(63, 182, 160, 0.16) 0%, transparent 62%),
    radial-gradient(ellipse 55% 70% at 88% 20%, rgba(31, 111, 92, 0.1) 0%, transparent 58%);
  pointer-events: none;
  z-index: 0;
}

.page.is-dark .wash {
  background:
    radial-gradient(ellipse 70% 80% at 18% 30%, rgba(95, 211, 180, 0.12) 0%, transparent 62%),
    radial-gradient(ellipse 55% 70% at 88% 20%, rgba(31, 111, 92, 0.16) 0%, transparent 58%);
}

.overview {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: 28rpx 28rpx 26rpx;
  border-radius: 28rpx;
  background: var(--card);
  border: 1px solid var(--line);
  box-sizing: border-box;
  overflow: hidden;
  animation: me-rise 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.overview-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.overview-kicker {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.overview-hero {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.overview-num {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--teal);
  line-height: 0.95;
  letter-spacing: -2rpx;
}

.overview-unit {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.2;
}

.overview-progress {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.overview-progress-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.overview-progress-label {
  font-size: 22rpx;
  color: var(--muted);
}

.overview-progress-pct {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--teal);
}

.overview-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(31, 111, 92, 0.1);
  overflow: hidden;
}

.page.is-dark .overview-track {
  background: rgba(95, 211, 180, 0.14);
}

.overview-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #1f6f5c 0%, #3fb6a0 100%);
  min-width: 0;
  transition: width 0.35s ease;
}

.overview-stack {
  width: 92rpx;
  height: 140rpx;
  position: relative;
  flex-shrink: 0;
  align-self: center;
}

.stack-book {
  position: absolute;
  right: 0;
  width: 72rpx;
  height: 96rpx;
  border-radius: 10rpx 14rpx 12rpx 10rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
}

.stack-book.b1 {
  top: -8rpx;
  right: 28rpx;
  background: linear-gradient(160deg, #c9852a 0%, #e0a84a 100%);
  transform: rotate(-12deg);
  opacity: 0.88;
}

.stack-book.b2 {
  top: 8rpx;
  right: 10rpx;
  background: linear-gradient(160deg, #1f6f5c 0%, #3fb6a0 100%);
  transform: rotate(4deg);
  animation: me-book-bob 2.8s ease-in-out infinite;
}

.stack-book.b3 {
  top: 28rpx;
  right: 30rpx;
  width: 64rpx;
  height: 86rpx;
  background: linear-gradient(160deg, #5a7a9a 0%, #7f9bb8 100%);
  transform: rotate(14deg);
  opacity: 0.75;
}

.metrics {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  animation: me-rise 0.42s cubic-bezier(0.22, 1, 0.36, 1) 0.06s both;
}

.metric {
  flex: 1;
  min-width: 0;
  padding: 22rpx 10rpx 18rpx;
  border-radius: 22rpx;
  background: var(--card);
  border: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.metric-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--teal);
  line-height: 1.15;
}

.metric-label {
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.2;
}

.section {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  animation: me-rise 0.42s cubic-bezier(0.22, 1, 0.36, 1) 0.12s both;
}

.section-title {
  display: block;
  margin: 0 8rpx 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.menu {
  display: flex;
  flex-direction: column;
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 24rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.page-foot {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 36rpx;
  margin-bottom: 24rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--soft);
  letter-spacing: 2rpx;
}

@keyframes me-rise {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes me-book-bob {
  0%,
  100% {
    transform: rotate(4deg) translateY(0);
  }
  50% {
    transform: rotate(4deg) translateY(-6rpx);
  }
}

.quota-sheet {
  max-height: 78vh;
}

.quota-head-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.quota-icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.quota-icon-btn-hover {
  background: rgba(42, 36, 28, 0.06);
}

.page.is-dark .quota-icon-btn-hover {
  background: rgba(255, 255, 255, 0.08);
}

.quota-icon-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.quota-icon {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.quota-sheet-body {
  padding: 0 36rpx;
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.quota-sheet-meta {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.quota-source {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.3;
}

.quota-sheet-scroll {
  max-height: 52vh;
  width: 100%;
}

.quota-loading,
.quota-empty {
  padding: 48rpx 0 24rpx;
}

.quota-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  min-height: 360rpx;
  box-sizing: border-box;
}

.quota-cloud {
  position: relative;
  width: 160rpx;
  height: 96rpx;
  animation: quota-cloud-float 2.2s ease-in-out infinite;
}

.quota-cloud-puff {
  position: absolute;
  border-radius: 50%;
  background: linear-gradient(145deg, #5fd3b4 0%, #1f6f5c 100%);
  opacity: 0.92;
}

.quota-cloud-puff.p1 {
  width: 88rpx;
  height: 88rpx;
  left: 36rpx;
  top: 4rpx;
}

.quota-cloud-puff.p2 {
  width: 64rpx;
  height: 64rpx;
  left: 8rpx;
  top: 28rpx;
}

.quota-cloud-puff.p3 {
  width: 72rpx;
  height: 72rpx;
  right: 4rpx;
  top: 22rpx;
}

.quota-cloud-scan {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 18rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.85) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  animation: quota-scan 1.35s ease-in-out infinite;
  pointer-events: none;
}

.quota-meters {
  width: 100%;
  max-width: 480rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.quota-meter {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.quota-meter-label {
  width: 88rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.2;
}

.quota-meter-track {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(42, 36, 28, 0.08);
  overflow: hidden;
}

.page.is-dark .quota-meter-track {
  background: rgba(255, 255, 255, 0.1);
}

.quota-meter-fill {
  height: 100%;
  width: 36%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #1f6f5c 0%, #3fb6a0 55%, #7ad9c4 100%);
  animation: quota-meter-sweep 1.45s ease-in-out infinite;
}

.quota-meter-fill.m1 {
  animation-delay: 0s;
}

.quota-meter-fill.m2 {
  animation-delay: 0.18s;
}

.quota-meter-fill.m3 {
  animation-delay: 0.36s;
}

.quota-loading-text {
  font-size: 26rpx;
  color: #5a5046;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.page.is-dark .quota-loading-text {
  color: #9aa1b2;
}

@keyframes quota-cloud-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

@keyframes quota-scan {
  0% {
    transform: translateY(0);
    opacity: 0.2;
  }
  45% {
    opacity: 0.95;
  }
  100% {
    transform: translateY(52rpx);
    opacity: 0.15;
  }
}

@keyframes quota-meter-sweep {
  0% {
    width: 18%;
    opacity: 0.55;
  }
  50% {
    width: 78%;
    opacity: 1;
  }
  100% {
    width: 34%;
    opacity: 0.7;
  }
}

.quota-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 8rpx 0 12rpx;
  box-sizing: border-box;
}

.quota-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.quota-row-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.quota-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
}

.quota-remain {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--teal);
  font-weight: 600;
  line-height: 1.3;
}

.quota-bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(42, 36, 28, 0.06);
  overflow: hidden;
}

.page.is-dark .quota-bar {
  background: rgba(255, 255, 255, 0.08);
}

.quota-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #1f6f5c 0%, #3fb6a0 100%);
  min-width: 0;
  transition: width 0.25s ease;
}

.quota-bar-fill.warn {
  background: linear-gradient(90deg, #c9852a 0%, #e0a84a 100%);
}

.quota-detail {
  font-size: 20rpx;
  color: var(--soft);
  line-height: 1.35;
}

.quota-tip {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.5;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 22rpx;
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--line);
  border-radius: 0;
  box-sizing: border-box;
  min-height: 88rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-hover {
  background: var(--mint-soft);
}

.menu-item-switch {
  padding-right: 18rpx;
}

.menu-ico-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-ico-wrap.tone-mint {
  background: var(--mint-soft);
}

.menu-ico-wrap.tone-amber {
  background: var(--amber-soft);
}

.menu-ico-wrap.tone-night {
  background: var(--night-soft);
}

.menu-ico {
  width: 28rpx;
  height: 28rpx;
  display: block;
}

.menu-label-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-label-wrap .menu-label {
  flex: 0 1 auto;
}

.menu-label {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 400;
  color: #3d3a33;
  letter-spacing: 0.5rpx;
  line-height: 1.35;
}

.page.is-dark .menu-label {
  color: #d8dbe3;
}

.menu-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e54d42;
  box-shadow: 0 0 0 3rpx rgba(229, 77, 66, 0.18);
  flex-shrink: 0;
}

.menu-arrow {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  display: block;
  opacity: 0.9;
}

.mint-switch {
  flex-shrink: 0;
  width: 76rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #e4e0d8;
  padding: 3rpx;
  box-sizing: border-box;
  transition: background 0.22s ease;
}

.page.is-dark .mint-switch {
  background: #2c303b;
}

.mint-switch.on {
  background: linear-gradient(135deg, #1f6f5c 0%, #3fb6a0 100%);
}

.mint-switch-knob {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(36, 38, 31, 0.12);
  transform: translateX(0);
  transition: transform 0.22s ease;
}

.mint-switch.on .mint-switch-knob {
  transform: translateX(32rpx);
}

.feedback-sheet {
  max-height: 78vh;
}

.feedback-body {
  padding: 0 36rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
}

.feedback-tip {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.45;
}

.feedback-textarea {
  width: 100%;
  height: 280rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f8f6f1;
  border: 1px solid #e7e3d9;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.55;
  box-sizing: border-box;
}

.page.is-dark .feedback-textarea {
  background: #161922;
  border-color: #2c303b;
  color: #edeff5;
}

.feedback-contact {
  width: 100%;
  height: 80rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #f8f6f1;
  border: 1px solid #e7e3d9;
  font-size: 26rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.page.is-dark .feedback-contact {
  background: #161922;
  border-color: #2c303b;
  color: #edeff5;
}

.feedback-ph {
  color: #b3aea0;
}

.page.is-dark .feedback-ph {
  color: #6d7382;
}

.export-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  min-height: 420rpx;
  padding: 24rpx 36rpx 48rpx;
  box-sizing: border-box;
}

.export-pack {
  position: relative;
  width: 280rpx;
  height: 180rpx;
}

.export-sheet-stack {
  position: absolute;
  left: 24rpx;
  top: 28rpx;
  width: 96rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 2rpx solid #e7e3d9;
  box-sizing: border-box;
}

.page.is-dark .export-sheet-stack {
  background: #1c1f27;
  border-color: #2c303b;
}

.export-sheet-stack.s1 {
  transform: rotate(-8deg) translate(-6rpx, 8rpx);
  opacity: 0.55;
}

.export-sheet-stack.s2 {
  transform: rotate(-3deg) translate(4rpx, 2rpx);
  opacity: 0.8;
  animation: export-stack-pulse 1.4s ease-in-out infinite;
}

.export-doc {
  position: absolute;
  left: 36rpx;
  top: 18rpx;
  width: 96rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 2rpx solid #e7e3d9;
  padding: 18rpx 14rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  animation: export-doc-float 1.5s ease-in-out infinite;
  z-index: 2;
}

.page.is-dark .export-doc {
  background: #1c1f27;
  border-color: #2c303b;
}

.export-doc-line {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(31, 111, 92, 0.18);
  transform-origin: left center;
}

.page.is-dark .export-doc-line {
  background: rgba(95, 211, 180, 0.22);
}

.export-doc-line.l1 {
  width: 88%;
  animation: export-line-write 1.2s ease-in-out infinite;
}

.export-doc-line.l2 {
  width: 72%;
  animation: export-line-write 1.2s ease-in-out 0.12s infinite;
}

.export-doc-line.l3 {
  width: 80%;
  animation: export-line-write 1.2s ease-in-out 0.24s infinite;
}

.export-doc-line.l4 {
  width: 56%;
  animation: export-line-write 1.2s ease-in-out 0.36s infinite;
}

.export-arrow {
  position: absolute;
  left: 148rpx;
  top: 68rpx;
  width: 36rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #3fb6a0;
  animation: export-arrow-pulse 1.1s ease-in-out infinite;
}

.export-arrow::after {
  content: '';
  position: absolute;
  right: -2rpx;
  top: -6rpx;
  width: 0;
  height: 0;
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
  border-left: 12rpx solid #3fb6a0;
}

.export-file {
  position: absolute;
  right: 18rpx;
  top: 36rpx;
  width: 88rpx;
  height: 108rpx;
  border-radius: 14rpx 22rpx 14rpx 14rpx;
  background: linear-gradient(145deg, #1f6f5c 0%, #3fb6a0 100%);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 18rpx;
  box-sizing: border-box;
  animation: export-file-bounce 1.5s ease-in-out infinite;
  z-index: 3;
}

.export-file::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 28rpx;
  height: 28rpx;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 0 20rpx 0 12rpx;
}

.export-file-ext {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
  line-height: 1;
}

.export-loading-text {
  font-size: 26rpx;
  color: #5a5046;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.page.is-dark .export-loading-text {
  color: #9aa1b2;
}

@keyframes export-doc-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

@keyframes export-stack-pulse {
  0%,
  100% {
    opacity: 0.7;
  }
  50% {
    opacity: 1;
  }
}

@keyframes export-line-write {
  0%,
  100% {
    transform: scaleX(0.55);
    opacity: 0.4;
  }
  50% {
    transform: scaleX(1);
    opacity: 1;
  }
}

@keyframes export-arrow-pulse {
  0%,
  100% {
    opacity: 0.35;
    transform: translateX(0);
  }
  50% {
    opacity: 1;
    transform: translateX(8rpx);
  }
}

@keyframes export-file-bounce {
  0%,
  100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-6rpx) scale(1.04);
  }
}

/* 导出备份弹层 */
.export-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2200;
  background: rgba(42, 36, 28, 0.42);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: flex-end;
}

.export-sheet {
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border: 1px solid #e7e3d9;
  border-radius: 44rpx 44rpx 0 0;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.22s ease-out;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page.is-dark .export-sheet {
  background: #1c1f27;
  border-color: #2c303b;
}

.export-sheet.show {
  transform: translateY(0);
}

.export-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx 20rpx;
}

.export-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.export-close {
  font-size: 24rpx;
  color: var(--muted);
  padding: 8rpx 0 8rpx 16rpx;
}

.export-preview-wrap {
  margin: 0 36rpx;
  height: 440rpx;
  background: #f8f6f1;
  border: 1px solid #e7e3d9;
  border-radius: 24rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.page.is-dark .export-preview-wrap {
  background: #161922;
  border-color: #2c303b;
}

.export-preview {
  width: 100%;
  height: 440rpx;
}

.export-md {
  display: block;
  padding: 24rpx;
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  font-size: 22rpx;
  line-height: 1.7;
  color: #8a8677;
  white-space: pre-wrap;
  word-break: break-word;
  box-sizing: border-box;
}

.page.is-dark .export-md {
  color: #9aa1b2;
}

.export-actions {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
  background: #ffffff;
}

.page.is-dark .export-actions {
  background: #1c1f27;
}

.export-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.export-btn.ghost {
  background: #ffffff;
  border: 1px solid #e7e3d9;
  color: #5a5046;
}

.page.is-dark .export-btn.ghost {
  background: #1c1f27;
  border-color: #2c303b;
  color: #edeff5;
}

.export-btn.primary {
  background: linear-gradient(135deg, #1f6f5c 0%, #3fb6a0 100%);
  color: #ffffff;
  border: none;
}

.export-btn.disabled {
  opacity: 0.55;
  pointer-events: none;
}
