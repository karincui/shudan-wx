.mint-toast {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.mint-toast.is-loading {
  pointer-events: auto;
}

.mint-toast-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(246, 244, 239, 0.55);
  backdrop-filter: blur(6px);
}

.mint-toast-card {
  position: relative;
  z-index: 1;
  max-width: 70vw;
  min-width: 240rpx;
  padding: 36rpx 40rpx 32rpx;
  border-radius: 28rpx;
  background: rgba(28, 31, 39, 0.9);
  backdrop-filter: blur(12px);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-sizing: border-box;
  animation: mint-toast-in 0.26s cubic-bezier(0.34, 1.4, 0.64, 1) both;
}

.mint-toast-card.none {
  padding: 28rpx 36rpx;
}

.mint-toast-card.loading {
  min-width: 220rpx;
  padding: 40rpx 44rpx 34rpx;
  gap: 22rpx;
  background: #ffffff;
  border: 1px solid #e7e3d9;
  box-shadow: 0 18rpx 48rpx rgba(31, 111, 92, 0.12);
}

.mint-toast-check {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #1f6f5c 0%, #3fb6a0 100%);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 68rpx;
  text-align: center;
  margin-bottom: 4rpx;
}

.mint-toast-spin {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mint-toast-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #e7f3ef;
  border-top-color: #1f6f5c;
  border-right-color: #3fb6a0;
  box-sizing: border-box;
  animation: mint-toast-spin 0.85s linear infinite;
}

.mint-toast-core {
  width: 28rpx;
  height: 28rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #1f6f5c 0%, #3fb6a0 100%);
  animation: mint-toast-pulse 1.2s ease-in-out infinite;
}

.mint-toast-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1.4;
  text-align: center;
  word-break: break-word;
}

.mint-toast-card.loading .mint-toast-title {
  color: #5a5046;
  font-weight: 600;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.mint-toast-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.35;
  text-align: center;
}

@keyframes mint-toast-in {
  from {
    opacity: 0;
    transform: scale(0.92) translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@keyframes mint-toast-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes mint-toast-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(0.86);
    opacity: 0.75;
  }
}
